{
  "name": "jack-orlando",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "eslint . && prettier --check . && npm run check -w jack-orlando-re && npm run check -w jack-orlando-browser",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build -w jack-orlando-re && npm run build -w jack-orlando-browser",
    "test": "npm test -w jack-orlando-re && npm test -w jack-orlando-browser",
    "test:zip": "npm run test:zip -w jack-orlando-re",
    "play:node": "npm run play:node -w jack-orlando-re --",
    "play:desktop": "npm run play -w jack-orlando-desktop --",
    "build:web": "npm run build -w jack-orlando-play",
    "dev": "npm run dev -w jack-orlando-play",
    "dev:embed": "npm run dev -w jack-orlando-embed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
